# -------------------------------------------------------
# HexagonML ModelManager MCP Server - Environment Config
# -------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------
# Required
# ---------------------------

# API secret key for authenticating with the ModelManager service
SECRET_KEY=your-secret-key-here

# Base URL of the ModelManager API
# Local:  http://127.0.0.1:8000
# Docker: http://host.docker.internal:8000  (Mac/Windows)
#         http://172.17.0.1:8000            (Linux, default bridge)
MM_API_BASE_URL=http://127.0.0.1:8000

# Directory for storing generated output files (e.g. modelcard PDFs)
OUTPUT_DIR=/tmp/mm-output

# ---------------------------
# Optional (defaults shown)
# ---------------------------

# Network interface the MCP server listens on
HOST=0.0.0.0

# Port the MCP server listens on
PORT=9000
