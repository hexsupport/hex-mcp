{
  "api_endpoint": "/api/forecasting/get_forecast/",
  "description": "Complete collection of real-world response examples from the get_forecast API endpoint",
  "examples": [
    {
      "scenario": "Successful forecast retrieval with data",
      "request": {
        "usecase_id": 5,
        "series": "covid_total_census",
        "condition_one": "NCAL",
        "condition_two": "facility_1",
        "prediction_period": 30
      },
      "response": {
        "success": true,
        "method": "get_forecast",
        "status_code": 200,
        "data": {
          "resolved": true,
          "usecase": {
            "id": 5,
            "name": "Hospital Census Forecasting",
            "usecase_type": "Multi_Model_Forecasting"
          },
          "info": {
            "condition_type": "three_conditions",
            "required_filters": ["series", "condition_one", "condition_two"]
          },
          "filters_applied": {
            "series": "covid_total_census",
            "condition_one": "NCAL",
            "condition_two": "facility_1",
            "condition_three": null,
            "prediction_period": 30
          },
          "last_actual_update": "2026-04-07",
          "forecast": [
            {
              "Forecast Date": "2026-03-08",
              "Forecast Value": 125.5,
              "value_type": "covid_total_census",
              "rgn_cd": "NCAL",
              "fac_id_cd": "facility_1"
            },
            {
              "Forecast Date": "2026-03-09",
              "Forecast Value": 128.3,
              "value_type": "covid_total_census",
              "rgn_cd": "NCAL",
              "fac_id_cd": "facility_1"
            },
            {
              "Forecast Date": "2026-03-10",
              "Forecast Value": 131.2,
              "value_type": "covid_total_census",
              "rgn_cd": "NCAL",
              "fac_id_cd": "facility_1"
            }
          ]
        }
      }
    },
