  "response_patterns": {
    "success_with_data": {
      "http_status": 200,
      "success": true,
      "has_forecast_array": true,
      "forecast_array_length": ">= 0"
    },
    "success_with_candidates": {
      "http_status": 200,
      "success": true,
      "has_candidates_or_semantic_candidates": true,
      "requires_user_selection": true
    },
    "validation_error": {
      "http_status": 400,
      "success": false,
      "error_present": true,
      "data_may_contain_details": true
    },
    "not_found": {
      "http_status": 404,
      "success": false,
      "error_present": true,
      "data": null
    },
    "server_error": {
      "http_status": 500,
      "success": false,
      "error_present": true,
      "error_type_present": true,
      "data": null
    }
  }
